<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.aratie_os.system_upgrade</id>
  <name>System Updates</name>
  <summary>Check for operating system and Flatpak updates</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.aratie_os">
    <name translate="no">Aratie OS Developers</name>
  </developer>
  <description>
    <p>System Updates checks APT and Flatpak sources at Plasma login and opens Discover when the user chooses to update.</p>
  </description>
  <launchable type="desktop-id">system-upgrade.desktop</launchable>
  <icon type="stock">system-software-update</icon>
  <provides>
    <binary>system-upgrade</binary>
  </provides>
  <categories>
    <category>System</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="2.0.5" date="2026-11-17">
      <description translate="no">
        <p>Interface translated into 33 languages, a fix for a check that could hang when a command failed to start, and Debian packaging validated by installation tests.</p>
      </description>
    </release>
    <release version="2.0.4" date="2026-09-30">
      <description translate="no">
        <p>Prepare the first official release with corrected project metadata and licensing.</p>
      </description>
    </release>
    <release version="2.0.3" date="2026-09-30">
      <description translate="no">
        <p>Launch Discover with the original Plasma session environment.</p>
      </description>
    </release>
    <release version="2.0.2" date="2026-09-30">
      <description translate="no">
        <p>Respect phased updates by checking simulated APT installation operations.</p>
      </description>
    </release>
    <release version="2.0.1" date="2026-09-30">
      <description translate="no">
        <p>Fix false update alerts, skip live sessions and place the alert in the lower-right corner.</p>
      </description>
    </release>
    <release version="2.0.0" date="2026-09-29">
      <description translate="no">
        <p>Native C++ and Qt 6 reimplementation with APT and Flatpak detection, Discover integration, XDG autostart and Debian packaging.</p>
      </description>
    </release>
  </releases>
  <url type="homepage">https://github.com/mainuan/alerta-atualizacao</url>
</component>
